{
  "name": "swiggy-deal-bot",
  "version": "1.0.0",
  "description": "Telegram Alert Bot for Swiggy Instamart deals (5-Worker Interval Hunter)",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "cron": "node src/cron-runner.js",
    "server": "node src/server.js",
    "test:essentials": "node src/cron-runner.js essentials --skip-sync",
    "test:treats": "node src/cron-runner.js treats --skip-sync",
    "test:lifestyle": "node src/cron-runner.js lifestyle --skip-sync",
    "test:beverages": "node src/cron-runner.js beverages --skip-sync",
    "test:personal": "node src/cron-runner.js personal --skip-sync"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "puppeteer-core": "^25.10.0"
  },
  "devDependencies": {
    "terser": "^5.51.2"
  }
}
